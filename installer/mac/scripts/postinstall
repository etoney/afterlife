#!/bin/bash
# Clear the download (quarantine) flag on what was installed and reset the Audio Unit cache.
/usr/bin/xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/Afterlife.vst3" 2>/dev/null
/usr/bin/xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/Components/Afterlife.component" 2>/dev/null
/usr/bin/xattr -dr com.apple.quarantine "/Applications/Castle Danger Music Company/Guides" 2>/dev/null
/usr/bin/killall -9 AudioComponentRegistrar 2>/dev/null
exit 0
