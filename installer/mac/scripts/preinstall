#!/bin/bash
# Move hand-installed copies in the signed-in user's own plug-in folders aside, so the DAW sees only this one.
U=$(/usr/bin/stat -f%Su /dev/console)
[ -n "$U" ] && [ "$U" != "root" ] || exit 0
H=$(/usr/bin/dscl . -read "/Users/$U" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
[ -n "$H" ] && [ -d "$H" ] || exit 0
DEST="$H/Library/Audio/Plug-Ins Disabled/Castle Danger (older copies)"
STAMP=$(/bin/date +%Y-%m-%d_%H%M%S)
for p in "$H/Library/Audio/Plug-Ins/VST3/Afterlife.vst3" "$H/Library/Audio/Plug-Ins/VST3/Castle Danger/Afterlife.vst3" \
         "$H/Library/Audio/Plug-Ins/Components/Afterlife.component" "$H/Library/Audio/Plug-Ins/Components/Castle Danger/Afterlife.component"; do
  if [ -e "$p" ]; then
    /bin/mkdir -p "$DEST"
    n=$(/usr/bin/basename "$p")
    /bin/mv "$p" "$DEST/${n%.*} ($STAMP).${n##*.}"
    /usr/sbin/chown -R "$U" "$H/Library/Audio/Plug-Ins Disabled"
  fi
done
exit 0
